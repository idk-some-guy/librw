const char *prepassh_metal_src =
"#ifndef RW_METAL_METALRELIT_H\n"
"#define RW_METAL_METALRELIT_H\n"

"#ifdef __METAL_VERSION__\n"
"#define RL_MIN fmin\n"
"#define RL_MAX fmax\n"
"#define RL_SQRT sqrt\n"
"#define RL_ABS fabs\n"
"#else\n"
"#include <math.h>\n"
"#define RL_MIN fminf\n"
"#define RL_MAX fmaxf\n"
"#define RL_SQRT sqrtf\n"
"#define RL_ABS fabsf\n"
"#endif\n"

"struct RLColor { float r, g, b; };\n"
"struct RLVec3 { float x, y, z; };\n"
"struct RLSplit { float full, sun; };\n"

"// Shader fast math folds this NaN test away (fmax(NaN, 0) is 0, fully live): clamp the weight on the CPU.\n"
"static inline float\n"
"relitClampWeight(float w)\n"
"{\n"
"	if(!(w == w))\n"
"		return 1.0f;\n"
"	return RL_MIN(RL_MAX(w, 0.0f), 1.0f);\n"
"}\n"

"static inline float\n"
"relitPrelitScale(float w, bool prelit)\n"
"{\n"
"	return prelit ? relitClampWeight(w) : 1.0f;\n"
"}\n"

"static inline float\n"
"relitLiveShare(float w, bool prelit)\n"
"{\n"
"	return prelit ? 1.0f - relitClampWeight(w) : 1.0f;\n"
"}\n"

"static inline RLColor\n"
"relitHemisphere(float nz, RLColor top, RLColor bottom)\n"
"{\n"
"	float t = RL_MIN(RL_MAX(nz*0.5f + 0.5f, 0.0f), 1.0f);\n"
"	RLColor c = { bottom.r + (top.r - bottom.r)*t, bottom.g + (top.g - bottom.g)*t, bottom.b + (top.b - bottom.b)*t };\n"
"	return c;\n"
"}\n"

"static inline RLColor\n"
"relitDesaturate(RLColor c, float s)\n"
"{\n"
"	float l = 0.299f*c.r + 0.587f*c.g + 0.114f*c.b;\n"
"	RLColor r = { l + (c.r - l)*s, l + (c.g - l)*s, l + (c.b - l)*s };\n"
"	return r;\n"
"}\n"

"static inline RLSplit\n"
"relitSplit(float base, float sun, float mat)\n"
"{\n"
"	RLSplit s;\n"
"	s.full = RL_MIN(RL_MAX(base + sun, 0.0f), 1.0f)*mat;\n"
"	s.sun = s.full - RL_MIN(RL_MAX(base, 0.0f), 1.0f)*mat;\n"
"	return s;\n"
"}\n"

"static inline float\n"
"relitShadowed(float full, float sunPart, float shadow)\n"
"{\n"
"	return full - (1.0f - RL_MIN(RL_MAX(shadow, 0.0f), 1.0f))*sunPart;\n"
"}\n"

"static inline float\n"
"relitFacedShadow(float shadow, float nDotToSun, float traced)\n"
"{\n"
"	return traced == 0.0f || nDotToSun > 0.0f ? shadow : 0.0f;\n"
"}\n"

"static inline float\n"
"relitShadowedPrelit(float full, float sunPart, float classic, float shadow, float facedShadow, float strength)\n"
"{\n"
"	float open = 1.0f - RL_MIN(RL_MAX(shadow, 0.0f), 1.0f), facedOpen = 1.0f - RL_MIN(RL_MAX(facedShadow, 0.0f), 1.0f);\n"
"	return full - open*sunPart - RL_MIN(RL_MAX(strength, 0.0f), 1.0f)*facedOpen*classic;\n"
"}\n"

"static inline float\n"
"relitPlainShadowed(float c, float shadow, float strength)\n"
"{\n"
"	float open = 1.0f - RL_MIN(RL_MAX(shadow, 0.0f), 1.0f);\n"
"	return c*(1.0f - RL_MIN(RL_MAX(strength, 0.0f), 1.0f)*open);\n"
"}\n"

"static inline float\n"
"relitWeighted(float c, float w)\n"
"{\n"
"	return w < 1.0f ? c*w : c;\n"
"}\n"

"static inline RLSplit\n"
"relitSplitAdd(float classic, float hemi, float sun, float mat)\n"
"{\n"
"	float room = RL_MAX(mat - classic, 0.0f);\n"
"	float base = RL_MIN(hemi*mat, room);\n"
"	RLSplit s;\n"
"	s.sun = RL_MIN(sun*mat, room - base);\n"
"	s.full = classic + base + s.sun;\n"
"	return s;\n"
"}\n"

"static inline float\n"
"relitSunCos(float c, bool twoSided)\n"
"{\n"
"	return twoSided ? RL_ABS(c) : RL_MAX(c, 0.0f);\n"
"}\n"

"#ifndef __METAL_VERSION__\n"
"static inline float\n"
"relitSnapWeight(float w)\n"
"{\n"
"	float c = relitClampWeight(w);\n"
"	return c > 1.0f - 1e-6f ? 1.0f : c;\n"
"}\n"

"static inline void\n"
"relitCofactor(const float c0[3], const float c1[3], const float c2[3], float out[9])\n"
"{\n"
"	out[0] = c1[1]*c2[2] - c1[2]*c2[1];\n"
"	out[1] = c1[2]*c2[0] - c1[0]*c2[2];\n"
"	out[2] = c1[0]*c2[1] - c1[1]*c2[0];\n"
"	out[3] = c2[1]*c0[2] - c2[2]*c0[1];\n"
"	out[4] = c2[2]*c0[0] - c2[0]*c0[2];\n"
"	out[5] = c2[0]*c0[1] - c2[1]*c0[0];\n"
"	out[6] = c0[1]*c1[2] - c0[2]*c1[1];\n"
"	out[7] = c0[2]*c1[0] - c0[0]*c1[2];\n"
"	out[8] = c0[0]*c1[1] - c0[1]*c1[0];\n"
"}\n"
"#endif\n"

"static inline RLVec3\n"
"relitFillNormal(RLVec3 n, float valid, RLVec3 g, RLVec3 fallback)\n"
"{\n"
"	float gg = g.x*g.x + g.y*g.y + g.z*g.z;\n"
"	if(gg < 1e-30f)\n"
"		g = fallback;\n"
"	else{\n"
"		float gl = RL_SQRT(gg);\n"
"		g.x /= gl;\n"
"		g.y /= gl;\n"
"		g.z /= gl;\n"
"	}\n"
"	if(n.x*g.x + n.y*g.y + n.z*g.z < 0.0f){\n"
"		n.x = -n.x;\n"
"		n.y = -n.y;\n"
"		n.z = -n.z;\n"
"	}\n"
"	float v = RL_MIN(RL_MAX(valid, 0.0f), 1.0f);\n"
"	float nn = n.x*n.x + n.y*n.y + n.z*n.z;\n"
"	float d = nn > 1e-30f ? v/RL_SQRT(nn) : 0.0f;\n"
"	RLVec3 r = { n.x*d + g.x*(1.0f - v), n.y*d + g.y*(1.0f - v), n.z*d + g.z*(1.0f - v) };\n"
"	float rr = r.x*r.x + r.y*r.y + r.z*r.z;\n"
"	if(rr < 1e-12f)\n"
"		return g;\n"
"	float rl = RL_SQRT(rr);\n"
"	r.x /= rl;\n"
"	r.y /= rl;\n"
"	r.z /= rl;\n"
"	return r;\n"
"}\n"

"#define RL_FACING_REFLECT (-0.3f)\n"

"static inline RLVec3\n"
"relitFacingNormal(RLVec3 n, RLVec3 v)\n"
"{\n"
"	float c = n.x*v.x + n.y*v.y + n.z*v.z;\n"
"	if(!(RL_ABS(c) <= 2.0f))\n"
"		return v;\n"
"	if(c >= 0.0f)\n"
"		return n;\n"
"	RLVec3 r = { -n.x, -n.y, -n.z };\n"
"	if(c <= RL_FACING_REFLECT)\n"
"		return r;\n"
"	r.x = n.x - 2.0f*c*v.x;\n"
"	r.y = n.y - 2.0f*c*v.y;\n"
"	r.z = n.z - 2.0f*c*v.z;\n"
"	float l = RL_SQRT(r.x*r.x + r.y*r.y + r.z*r.z);\n"
"	r.x /= l;\n"
"	r.y /= l;\n"
"	r.z /= l;\n"
"	return r;\n"
"}\n"

"static inline RLVec3\n"
"relitSurfaceNormal(RLVec3 n, float valid, RLVec3 g, RLVec3 toEye, RLVec3 fallback)\n"
"{\n"
"	if(g.x*toEye.x + g.y*toEye.y + g.z*toEye.z < 0.0f){\n"
"		g.x = -g.x;\n"
"		g.y = -g.y;\n"
"		g.z = -g.z;\n"
"	}\n"
"	RLVec3 f = relitFillNormal(n, valid, g, fallback);\n"
"	float ee = toEye.x*toEye.x + toEye.y*toEye.y + toEye.z*toEye.z;\n"
"	if(!(ee > 1e-30f))\n"
"		return f;\n"
"	float el = RL_SQRT(ee);\n"
"	RLVec3 v = { toEye.x/el, toEye.y/el, toEye.z/el };\n"
"	return relitFacingNormal(f, v);\n"
"}\n"

"#endif\n"
"#ifndef RW_METAL_METALPREPASS_H\n"
"#define RW_METAL_METALPREPASS_H\n"

"#ifdef __METAL_VERSION__\n"
"#define PP_ABS fabs\n"
"#define PP_SQRT sqrt\n"
"#else\n"
"#include <math.h>\n"
"#include <stddef.h>\n"
"#include <stdint.h>\n"
"#include \"metalrelit.h\"\n"
"#define PP_ABS fabsf\n"
"#define PP_SQRT sqrtf\n"
"#endif\n"

"#define PP_MOTION_OFFSCREEN 2.0f\n"
"#define PP_CUTOUT_SOLID (254.0f/255.0f)\n"
"#define PP_LAYER_MIN 0.5f\n"
"#define PP_BLEND_SRCALPHA 5\n"
"#define PP_BLEND_INVSRCALPHA 6\n"

"struct PPVec2 { float x, y; };\n"
"struct PPVec3 { float x, y, z; };\n"

"static inline float\n"
"ppSign(float v)\n"
"{\n"
"	return v >= 0.0f ? 1.0f : -1.0f;\n"
"}\n"

"static inline PPVec2\n"
"ppOctEncode(float x, float y, float z)\n"
"{\n"
"	PPVec2 r;\n"
"	float s = PP_ABS(x) + PP_ABS(y) + PP_ABS(z);\n"
"	if(!(s > 0.0f)){\n"
"		r.x = 0.0f;\n"
"		r.y = 0.0f;\n"
"		return r;\n"
"	}\n"
"	x /= s;\n"
"	y /= s;\n"
"	if(z < 0.0f){\n"
"		r.x = (1.0f - PP_ABS(y))*ppSign(x);\n"
"		r.y = (1.0f - PP_ABS(x))*ppSign(y);\n"
"	}else{\n"
"		r.x = x;\n"
"		r.y = y;\n"
"	}\n"
"	return r;\n"
"}\n"

"static inline PPVec3\n"
"ppOctDecode(float u, float v)\n"
"{\n"
"	PPVec3 n;\n"
"	n.z = 1.0f - PP_ABS(u) - PP_ABS(v);\n"
"	if(n.z < 0.0f){\n"
"		n.x = (1.0f - PP_ABS(v))*ppSign(u);\n"
"		n.y = (1.0f - PP_ABS(u))*ppSign(v);\n"
"	}else{\n"
"		n.x = u;\n"
"		n.y = v;\n"
"	}\n"
"	float l = PP_SQRT(n.x*n.x + n.y*n.y + n.z*n.z);\n"
"	n.x /= l;\n"
"	n.y /= l;\n"
"	n.z /= l;\n"
"	return n;\n"
"}\n"

"static inline float\n"
"ppNormalStored(float u, float v)\n"
"{\n"
"	return u != 0.0f || v != 0.0f ? 1.0f : 0.0f;\n"
"}\n"

"#define PP_FACING_REFLECT RL_FACING_REFLECT\n"

"static inline PPVec3\n"
"ppFacingNormal(PPVec3 n, PPVec3 v)\n"
"{\n"
"	RLVec3 f = relitFacingNormal(RLVec3{ n.x, n.y, n.z }, RLVec3{ v.x, v.y, v.z });\n"
"	PPVec3 r = { f.x, f.y, f.z };\n"
"	return r;\n"
"}\n"

"static inline PPVec2\n"
"ppMotion(float cx, float cy, float cw, float px, float py, float pw)\n"
"{\n"
"	PPVec2 m;\n"
"	if(!(cw > 0.0f) || !(pw > 0.0f)){\n"
"		m.x = PP_MOTION_OFFSCREEN;\n"
"		m.y = PP_MOTION_OFFSCREEN;\n"
"		return m;\n"
"	}\n"
"	m.x = 0.5f*(px/pw - cx/cw);\n"
"	m.y = -0.5f*(py/pw - cy/cw);\n"
"	return m;\n"
"}\n"

"// Texels that blend keep the depth behind them, so only solid texels enter the prepass.\n"
"static inline bool\n"
"ppCutoutKeep(float alpha, float ref)\n"
"{\n"
"	return alpha >= (ref > PP_CUTOUT_SOLID ? ref : PP_CUTOUT_SOLID);\n"
"}\n"

"static inline bool\n"
"ppLayerKeep(float alpha, float ref)\n"
"{\n"
"	return alpha >= (ref > PP_LAYER_MIN ? ref : PP_LAYER_MIN);\n"
"}\n"

"#ifndef __METAL_VERSION__\n"
"struct PrepassDraw\n"
"{\n"
"	bool blend;\n"
"	bool ztest;\n"
"	bool zwrite;\n"
"	bool sceneDepth;\n"
"	bool instanced;\n"
"	bool alphaTested;\n"
"	int srcBlend;\n"
"	int destBlend;\n"
"};\n"

"inline bool\n"
"prepassEligible(const PrepassDraw &d)\n"
"{\n"
"	return !d.blend && d.ztest && d.zwrite && d.sceneDepth && d.instanced;\n"
"}\n"

"inline bool\n"
"prepassCutout(const PrepassDraw &d)\n"
"{\n"
"	return d.blend && d.srcBlend == PP_BLEND_SRCALPHA && d.destBlend == PP_BLEND_INVSRCALPHA && d.alphaTested && d.ztest &&\n"
"		d.zwrite && d.sceneDepth && d.instanced;\n"
"}\n"

"inline bool\n"
"ppLayerRuns(bool shadowPass, uint32_t layerDraws)\n"
"{\n"
"	return shadowPass && layerDraws > 0;\n"
"}\n"

"inline uint64_t\n"
"prepassMix(uint64_t h, const void *p, size_t n)\n"
"{\n"
"	const unsigned char *b = (const unsigned char*)p;\n"
"	for(size_t i = 0; i < n; i++){\n"
"		h ^= b[i];\n"
"		h *= 1099511628211ull;\n"
"	}\n"
"	return h;\n"
"}\n"

"inline uint64_t\n"
"prepassKey(const void *inst, const float world[16], const float *bone0, bool cutout)\n"
"{\n"
"	uint64_t h = 14695981039346656037ull;\n"
"	h = prepassMix(h, &inst, sizeof(inst));\n"
"	h = prepassMix(h, &cutout, sizeof(cutout));\n"
"	h = prepassMix(h, world, 16*sizeof(float));\n"
"	if(bone0)\n"
"		h = prepassMix(h, bone0, 16*sizeof(float));\n"
"	return h;\n"
"}\n"
"#endif\n"

"#endif\n"
;
