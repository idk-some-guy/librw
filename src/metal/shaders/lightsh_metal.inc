"static inline float\n"
"ltSaturate(float v)\n"
"{\n"
"	return LT_MIN(LT_MAX(v, 0.0f), 1.0f);\n"
"}\n"

"static inline float\n"
"ltEmissivePeak(float luma, float scale)\n"
"{\n"
"	float t = ltSaturate((luma - 0.6f)/0.3f);\n"
"	return 1.0f + (scale - 1.0f)*t*t*(3.0f - 2.0f*t);\n"
"}\n"

"static inline float\n"
"ltEmissiveGate(float r, float g, float b, float scale)\n"
"{\n"
"	return ltEmissivePeak(LT_MAX(LT_MAX(r, g), b), scale);\n"
"}\n"

"static inline float\n"
"ltFalloff(float d2, float radius)\n"
"{\n"
"	if(!(radius > 0.0f) || !(d2 >= 0.0f))\n"
"		return 0.0f;\n"
"	float q = d2/(radius*radius);\n"
"	float w = ltSaturate(1.0f - q*q);\n"
"	return w*w/(d2 + 0.01f);\n"
"}\n"

"static inline float\n"
"ltSpot(float cosAngle, float cosOuter, float cosInner)\n"
"{\n"
"	if(cosOuter <= -1.0f)\n"
"		return 1.0f;\n"
"	float t = ltSaturate((cosAngle - cosOuter)/(cosInner - cosOuter));\n"
"	return t*t*(3.0f - 2.0f*t);\n"
"}\n"

"static inline float\n"
"ltSpecular(float nh, float gloss)\n"
"{\n"
"	if(!(gloss > 0.0f))\n"
"		return 0.0f;\n"
"	return gloss*LT_POW(LT_MAX(nh, 0.0f), 8.0f + 120.0f*gloss);\n"
"}\n"

"static inline unsigned int\n"
"ltSlice(float viewZ, float zNear, float zFar)\n"
"{\n"
"	float s = LT_LOG(LT_MAX(viewZ, zNear)/zNear)/LT_LOG(zFar/zNear)*(float)LT_CLUSTER_Z;\n"
"	s = LT_MIN(LT_MAX(s, 0.0f), (float)(LT_CLUSTER_Z - 1));\n"
"	return (unsigned int)LT_FLOOR(s + 0.0001f);\n"
"}\n"

"static inline float\n"
"ltSliceNear(unsigned int k, float zNear, float zFar)\n"
"{\n"
"	return zNear*LT_EXP(LT_LOG(zFar/zNear)*(float)k/(float)LT_CLUSTER_Z);\n"
"}\n"

"static inline unsigned int\n"
"ltCluster(float px, float py, float viewZ, float width, float height, float zNear, float zFar)\n"
"{\n"
"	float fx = LT_FLOOR(px/width*(float)LT_CLUSTER_X);\n"
"	float fy = LT_FLOOR(py/height*(float)LT_CLUSTER_Y);\n"
"	fx = LT_MIN(LT_MAX(fx, 0.0f), (float)(LT_CLUSTER_X - 1));\n"
"	fy = LT_MIN(LT_MAX(fy, 0.0f), (float)(LT_CLUSTER_Y - 1));\n"
"	unsigned int z = ltSlice(viewZ, zNear, zFar);\n"
"	return (unsigned int)fx + LT_CLUSTER_X*((unsigned int)fy + LT_CLUSTER_Y*z);\n"
"}\n"

"static inline bool\n"
"ltSphereHitsBox(LTVec3 c, float r, LTVec3 lo, LTVec3 hi)\n"
"{\n"
"	float dx = c.x - LT_MIN(LT_MAX(c.x, lo.x), hi.x);\n"
"	float dy = c.y - LT_MIN(LT_MAX(c.y, lo.y), hi.y);\n"
"	float dz = c.z - LT_MIN(LT_MAX(c.z, lo.z), hi.z);\n"
"	return dx*dx + dy*dy + dz*dz <= r*r;\n"
"}\n"

"static inline bool\n"
"ltConeHitsSphere(LTVec3 apex, LTVec3 dir, float cosOuter, float radius, LTVec3 centre, float sphereR)\n"
"{\n"
"	float vx = centre.x - apex.x, vy = centre.y - apex.y, vz = centre.z - apex.z;\n"
"	float d2 = vx*vx + vy*vy + vz*vz;\n"
"	float reach = radius + sphereR;\n"
"	if(d2 > reach*reach)\n"
"		return false;\n"
"	if(d2 <= sphereR*sphereR || cosOuter <= -1.0f)\n"
"		return true;\n"
"	float d = LT_SQRT(d2);\n"
"	float cosA = (vx*dir.x + vy*dir.y + vz*dir.z)/d;\n"
"	if(cosA >= cosOuter)\n"
"		return true;\n"
"	float sinB = LT_MIN(sphereR/d, 1.0f);\n"
"	float cosB = LT_SQRT(1.0f - sinB*sinB);\n"
"	float sinO = LT_SQRT(LT_MAX(1.0f - cosOuter*cosOuter, 0.0f));\n"
"	if(sinO*cosB + cosOuter*sinB < 0.0f)\n"
"		return true;\n"
"	return cosA >= cosOuter*cosB - sinO*sinB;\n"
"}\n"

"static inline float\n"
"ltScore(float intensity, float d2)\n"
"{\n"
"	return intensity/LT_MAX(d2, 1.0f);\n"
"}\n"

"static inline int\n"
"ltBudget(int setting, int shadowQuality)\n"
"{\n"
"	if(shadowQuality <= 0)\n"
"		return 0;\n"
"	if(setting < 0){\n"
"		if(shadowQuality == 2) return 2;\n"
"		if(shadowQuality >= 3) return 4;\n"
"		return 0;\n"
"	}\n"
"	return setting > LT_MAX_SHADOWED ? LT_MAX_SHADOWED : setting;\n"
"}\n"

"#ifndef __METAL_VERSION__\n"
"#define LT_CAND_PINNED 1u\n"
"#define LT_CAND_EMPTY 2u\n"
"#define LT_NO_ID 0xFFFFFFFFu\n"

"struct LTCand { float score; unsigned id; unsigned flags; unsigned group; int held; };\n"

"static inline int\n"
"ltPickShadowed(const LTCand *c, int n, int budget, int out[LT_MAX_SHADOWED])\n"
"{\n"
"	if(budget > LT_MAX_SHADOWED)\n"
"		budget = LT_MAX_SHADOWED;\n"
"	if(n > LT_MAX_LIGHTS)\n"
"		n = LT_MAX_LIGHTS;\n"
"	if(budget <= 0 || n <= 0)\n"
"		return 0;\n"
"	bool taken[LT_MAX_LIGHTS] = {};\n"
"	unsigned groups[LT_MAX_SHADOWED];\n"
"	int count = 0, ngroups = 0;\n"
"	for(int i = 0; i < n && count < budget; i++){\n"
"		if(!(c[i].flags & LT_CAND_PINNED))\n"
"			continue;\n"
"		bool dup = false;\n"
"		for(int g = 0; c[i].group && g < ngroups; g++)\n"
"			dup = dup || groups[g] == c[i].group;\n"
"		if(dup)\n"
"			continue;\n"
"		taken[i] = true;\n"
"		if(c[i].group)\n"
"			groups[ngroups++] = c[i].group;\n"
"		out[count++] = i;\n"
"	}\n"
"	float bestUnheld = 0.0f;\n"
"	for(int i = 0; i < n; i++)\n"
"		if(!taken[i] && c[i].held <= 0 && c[i].score > bestUnheld)\n"
"			bestUnheld = c[i].score;\n"
"	for(int pass = 0; pass < 2; pass++){\n"
"		while(count < budget){\n"
"			int best = -1;\n"
"			for(int i = 0; i < n; i++){\n"
"				if(taken[i] || !(c[i].score > 0.0f))\n"
"					continue;\n"
"				if(pass == 0 && !(c[i].held > 0 && c[i].score >= 0.5f*bestUnheld))\n"
"					continue;\n"
"				bool dup = false;\n"
"				for(int g = 0; c[i].group && g < ngroups; g++)\n"
"					dup = dup || groups[g] == c[i].group;\n"
"				if(dup)\n"
"					continue;\n"
"				if(best < 0 || c[i].score > c[best].score)\n"
"					best = i;\n"
"			}\n"
"			if(best < 0)\n"
"				break;\n"
"			taken[best] = true;\n"
"			if(c[best].group)\n"
"				groups[ngroups++] = c[best].group;\n"
"			out[count++] = best;\n"
"		}\n"
"	}\n"
"	return count;\n"
"}\n"

"static inline bool\n"
"ltInView(const float *m, LTVec3 c, float radius)\n"
"{\n"
"	for(int k = 0; k < 6; k++){\n"
"		int i = k >> 1;\n"
"		float s = (k & 1) ? -1.0f : 1.0f;\n"
"		float a = m[3] + s*m[i], b = m[7] + s*m[4 + i], cc = m[11] + s*m[8 + i], d = m[15] + s*m[12 + i];\n"
"		float len = LT_SQRT(a*a + b*b + cc*cc);\n"
"		if(!(a*c.x + b*c.y + cc*c.z + d >= -radius*len))\n"
"			return false;\n"
"	}\n"
"	return true;\n"
"}\n"

"static inline int\n"
"ltHoldNext(int held, bool picked, int holdFrames)\n"
"{\n"
"	if(picked)\n"
"		return holdFrames > 0 ? holdFrames : 0;\n"
"	return held > 0 ? held - 1 : 0;\n"
"}\n"

"static inline int\n"
"ltHoldAge(int held, uint64_t skipped)\n"
"{\n"
"	return held > 0 && skipped < (uint64_t)held ? held - (int)skipped : 0;\n"
"}\n"

"static inline bool\n"
"ltSlotReset(bool hadPrev, unsigned int prevId, unsigned int id)\n"
"{\n"
"	return !hadPrev || prevId != id;\n"
"}\n"

"static inline unsigned int\n"
"ltGroupIdentity(const LTCand *c, int n, int i)\n"
"{\n"
"	unsigned int id = c[i].id;\n"
"	if(c[i].group == 0)\n"
"		return id;\n"
"	for(int j = 0; j < n; j++)\n"
"		if(c[j].group == c[i].group && c[j].id < id)\n"
"			id = c[j].id;\n"
"	return id;\n"
"}\n"

"static inline unsigned int\n"
"ltMixId(unsigned int x)\n"
"{\n"
"	x ^= x >> 16;\n"
"	x *= 0x85ebca6bu;\n"
"	x ^= x >> 13;\n"
"	x *= 0xc2b2ae35u;\n"
"	x ^= x >> 16;\n"
"	return x + 1u;\n"
"}\n"

"static inline unsigned int\n"
"ltGroupSignature(const LTCand *c, int n, int i)\n"
"{\n"
"	if(c[i].group == 0)\n"
"		return 0u;\n"
"	unsigned int sig = 0u;\n"
"	for(int j = 0; j < n; j++)\n"
"		if(j == i || (c[j].group == c[i].group && !(c[j].flags & LT_CAND_EMPTY)))\n"
"			sig += ltMixId(c[j].id);\n"
"	return sig;\n"
"}\n"

"static inline void\n"
"ltIdentify(LTCand *c, int n, unsigned int *idents, unsigned int *sigs)\n"
"{\n"
"	for(int i = 0; i < n; i++){\n"
"		idents[i] = ltGroupIdentity(c, n, i);\n"
"		sigs[i] = ltGroupSignature(c, n, i);\n"
"	}\n"
"	for(int i = 0; i < n; i++)\n"
"		c[i].id = idents[i];\n"
"}\n"

"static inline unsigned int\n"
"ltHoleMask(const int *slots, int span)\n"
"{\n"
"	unsigned int mask = 0u;\n"
"	for(int k = 0; k < span && k < 32; k++)\n"
"		if(slots[k] < 0)\n"
"			mask |= 1u << k;\n"
"	return mask;\n"
"}\n"

"struct LTRoll { uint64_t frame; unsigned int cur, prev; bool fresh, scene; };\n"

"static inline void\n"
"ltRollCandidates(LTRoll *r, uint64_t f)\n"
"{\n"
"	if(f == r->frame)\n"
"		return;\n"
"	if(r->fresh){\n"
"		r->prev = f == r->frame + 1 ? r->cur : 0;\n"
"		r->cur = 0;\n"
"		r->fresh = r->scene = false;\n"
"	}else if(r->scene){\n"
"		r->prev = 0;\n"
"		r->scene = false;\n"
"	}else if(f != r->frame + 1)\n"
"		r->prev = 0;\n"
"	r->frame = f;\n"
"}\n"

"static inline bool\n"
"ltRunContinues(bool ran, uint64_t prevFrame, uint64_t frame)\n"
"{\n"
"	return ran && frame >= prevFrame && frame - prevFrame <= 1;\n"
"}\n"

"static inline int\n"
"ltOrderSlots(int *slots, int budget, const int *picked, int count, const LTCand *c, const unsigned int *prevIds, int prevCount, unsigned int prevHoles)\n"
"{\n"
"	if(budget > LT_MAX_SHADOWED)\n"
"		budget = LT_MAX_SHADOWED;\n"
"	if(count > budget)\n"
"		count = budget;\n"
"	bool used[LT_MAX_SHADOWED] = {};\n"
"	for(int k = 0; k < budget; k++)\n"
"		slots[k] = -1;\n"
"	for(int j = 0; j < count; j++)\n"
"		for(int k = 0; k < budget && k < prevCount; k++)\n"
"			if(slots[k] < 0 && !((prevHoles >> k) & 1u) && prevIds[k] == c[picked[j]].id){\n"
"				slots[k] = picked[j];\n"
"				used[j] = true;\n"
"				break;\n"
"			}\n"
"	int next = 0;\n"
"	for(int j = 0; j < count; j++){\n"
"		if(used[j])\n"
"			continue;\n"
"		while(slots[next] >= 0)\n"
"			next++;\n"
"		slots[next] = picked[j];\n"
"	}\n"
"	int span = 0;\n"
"	for(int k = 0; k < budget; k++)\n"
"		if(slots[k] >= 0)\n"
"			span = k + 1;\n"
"	return span;\n"
"}\n"

"static inline int\n"
"ltSlotFor(const LTCand *c, int n, const int *picked, int count, int i)\n"
"{\n"
"	for(int k = 0; k < count; k++)\n"
"		if(picked[k] >= 0 && (picked[k] == i || (c[i].group != 0 && picked[k] < n && c[picked[k]].group == c[i].group)))\n"
"			return k;\n"
"	return -1;\n"
"}\n"

"static inline int\n"
"ltEntrySlot(int slot, unsigned int slots, bool ranPass)\n"
"{\n"
"	return ranPass && slot >= 0 && (unsigned int)slot < slots ? slot : -1;\n"
"}\n"

"static inline bool\n"
"ltLightTextureBound(bool ranPass, unsigned int slots)\n"
"{\n"
"	return ranPass && slots > 0;\n"
"}\n"

"#define LT_LEVER_TILES 1u\n"
"#define LT_LEVER_HISTORY 2u\n"
"#define LT_LEVERS_ALL 3u\n"

"static inline unsigned int\n"
"ltHistorySlices(int budget, bool atBudget)\n"
"{\n"
"	if(!atBudget)\n"
"		return LT_MAX_SHADOWED;\n"
"	return budget <= 0 ? 0u : budget > LT_MAX_SHADOWED ? (unsigned int)LT_MAX_SHADOWED : (unsigned int)budget;\n"
"}\n"

"#define LT_TILE 8\n"
"#define LT_TAP_MARGIN 2\n"
"#define LT_CLAMP_MARGIN 1\n"

"struct LTRect { int x0, y0, x1, y1; };\n"

"static inline bool\n"
"ltRectEmpty(LTRect r)\n"
"{\n"
"	return r.x1 <= r.x0 || r.y1 <= r.y0;\n"
"}\n"

"static inline bool\n"
"ltRectHas(LTRect r, int x, int y)\n"
"{\n"
"	return x >= r.x0 && x < r.x1 && y >= r.y0 && y < r.y1;\n"
"}\n"

"static inline LTRect\n"
"ltUnionRect(LTRect a, LTRect b)\n"
"{\n"
"	if(ltRectEmpty(a))\n"
"		return ltRectEmpty(b) ? LTRect{ 0, 0, 0, 0 } : b;\n"
"	if(ltRectEmpty(b))\n"
"		return a;\n"
"	return LTRect{ std::min(a.x0, b.x0), std::min(a.y0, b.y0), std::max(a.x1, b.x1), std::max(a.y1, b.y1) };\n"
"}\n"

"static inline LTRect\n"
"ltAlignRect(LTRect r, int tile, int width, int height)\n"
"{\n"
"	if(ltRectEmpty(r))\n"
"		return LTRect{ 0, 0, 0, 0 };\n"
"	LTRect o = { r.x0/tile*tile, r.y0/tile*tile, (r.x1 + tile - 1)/tile*tile, (r.y1 + tile - 1)/tile*tile };\n"
"	o.x1 = std::min(o.x1, width);\n"
"	o.y1 = std::min(o.y1, height);\n"
"	return ltRectEmpty(o) ? LTRect{ 0, 0, 0, 0 } : o;\n"
"}\n"

"static inline bool\n"
"ltSphereSpan(float c, float cz, float r, float zn, float *lo, float *hi)\n"
"{\n"
"	float l = INFINITY, h = -INFINITY;\n"
"	float den = cz*cz - r*r, d = c*c + cz*cz - r*r;\n"
"	if(cz - r <= zn){\n"
"		float rim = r*r - (zn - cz)*(zn - cz);\n"
"		if(rim > 0.0f){\n"
"			float w = LT_SQRT(rim);\n"
"			l = LT_MIN(l, (c - w)/zn);\n"
"			h = LT_MAX(h, (c + w)/zn);\n"
"		}\n"
"	}\n"
"	if(d > 0.0f && std::fabs(den) > 1e-6f){\n"
"		float q = r*LT_SQRT(d);\n"
"		for(int k = 0; k < 2; k++){\n"
"			float u = (c*cz + (k ? q : -q))/den;\n"
"			float norm = LT_SQRT(1.0f + u*u), dist = (c - u*cz)/norm;\n"
"			if(cz + dist*u/norm >= zn){\n"
"				l = LT_MIN(l, u);\n"
"				h = LT_MAX(h, u);\n"
"			}\n"
"		}\n"
"	}else if(d > 0.0f)\n"
"		return false;\n"
"	*lo = l;\n"
"	*hi = h;\n"
"	return l <= h;\n"
"}\n"

"static inline float\n"
"ltNearFromProj(const float *m)\n"
"{\n"
"	float d = 1.0f + m[10], n = -m[14]/d;\n"
"	return m[11] > 0.0f && d > 0.0f && std::isfinite(n) && n > 0.0f ? n : 0.0f;\n"
"}\n"

"// the part behind the near plane is off screen\n"
"static inline LTRect\n"
"ltSphereRect(const float *m, float cx, float cy, float cz, float radius, float zNear, int width, int height)\n"
"{\n"
"	LTRect whole = { 0, 0, width, height };\n"
"	if(!(radius > 0.0f))\n"
"		return LTRect{ 0, 0, 0, 0 };\n"
"	if(!std::isfinite(cx) || !std::isfinite(cy) || !std::isfinite(cz) || !std::isfinite(radius) || !(zNear > 0.0f) || !(m[11] > 0.0f) ||\n"
"	   m[1] != 0.0f || m[3] != 0.0f || m[4] != 0.0f || m[7] != 0.0f || m[12] != 0.0f || m[13] != 0.0f || m[15] != 0.0f)\n"
"		return whole;\n"
"	float zn = zNear*0.98f;\n"
"	if(cz + radius <= zn)\n"
"		return LTRect{ 0, 0, 0, 0 };\n"
"	float k = m[11], ux0, ux1, uy0, uy1;\n"
"	if(!ltSphereSpan(cx, cz, radius, zn, &ux0, &ux1) || !ltSphereSpan(cy, cz, radius, zn, &uy0, &uy1))\n"
"		return whole;\n"
"	float ax = m[0]/k, bx = m[8]/k, ay = m[5]/k, by = m[9]/k;\n"
"	float px0 = (ax*ux0 + bx)*0.5f + 0.5f, px1 = (ax*ux1 + bx)*0.5f + 0.5f;\n"
"	float py0 = 0.5f - (ay*uy0 + by)*0.5f, py1 = 0.5f - (ay*uy1 + by)*0.5f;\n"
"	float x0 = LT_MIN(px0, px1)*(float)width, x1 = LT_MAX(px0, px1)*(float)width;\n"
"	float y0 = LT_MIN(py0, py1)*(float)height, y1 = LT_MAX(py0, py1)*(float)height;\n"
"	auto clampTo = [](float v, int limit){ return (int)LT_MIN(LT_MAX(v, -1.0f), (float)limit + 1.0f); };\n"
"	LTRect r = { clampTo(LT_FLOOR(x0), width) - 1, clampTo(LT_FLOOR(y0), height) - 1, clampTo(ceilf(x1), width) + 1, clampTo(ceilf(y1), height) + 1 };\n"
"	r.x0 = std::max(r.x0, 0);\n"
"	r.y0 = std::max(r.y0, 0);\n"
"	r.x1 = std::min(r.x1, width);\n"
"	r.y1 = std::min(r.y1, height);\n"
"	return ltRectEmpty(r) ? LTRect{ 0, 0, 0, 0 } : r;\n"
"}\n"

"static inline LTRect\n"
"ltAccumRect(LTRect full, int rawWidth, int rawHeight)\n"
"{\n"
"	if(ltRectEmpty(full))\n"
"		return LTRect{ 0, 0, 0, 0 };\n"
"	LTRect h = { std::max(full.x0/2 - LT_TAP_MARGIN, 0), std::max(full.y0/2 - LT_TAP_MARGIN, 0), (full.x1 + 1)/2 + LT_TAP_MARGIN,\n"
"		(full.y1 + 1)/2 + LT_TAP_MARGIN };\n"
"	return ltAlignRect(h, LT_TILE, rawWidth, rawHeight);\n"
"}\n"

"static inline LTRect\n"
"ltRayRect(LTRect accum, int rawWidth, int rawHeight)\n"
"{\n"
"	if(ltRectEmpty(accum))\n"
"		return LTRect{ 0, 0, 0, 0 };\n"
"	LTRect h = { std::max(accum.x0 - LT_CLAMP_MARGIN, 0), std::max(accum.y0 - LT_CLAMP_MARGIN, 0), accum.x1 + LT_CLAMP_MARGIN, accum.y1 + LT_CLAMP_MARGIN };\n"
"	return ltAlignRect(h, LT_TILE, rawWidth, rawHeight);\n"
"}\n"

"static inline LTRect\n"
"ltUpsampleRect(LTRect full, int width, int height)\n"
"{\n"
"	return ltAlignRect(full, LT_TILE, width, height);\n"
"}\n"

"struct LTRects { LTRect upsample, accum, ray; };\n"

"static inline LTRects\n"
"ltLightRects(LTRect full, int width, int height, int rawWidth, int rawHeight)\n"
"{\n"
"	LTRects r;\n"
"	r.upsample = ltUpsampleRect(full, width, height);\n"
"	r.accum = ltAccumRect(r.upsample, rawWidth, rawHeight);\n"
"	r.ray = ltRayRect(r.accum, rawWidth, rawHeight);\n"
"	return r;\n"
"}\n"
"#endif\n"

"static inline bool\n"
"ltInCone(LTVec3 v, LTVec3 dir, float cosOuter)\n"
"{\n"
"	return (v.x*dir.x + v.y*dir.y + v.z*dir.z) >= cosOuter*LT_SQRT(v.x*v.x + v.y*v.y + v.z*v.z);\n"
"}\n"

"static inline bool\n"
"ltRayWantedSlot(LTVec3 p, LTVec3 centre, float reach, LTVec3 off, LTVec3 dir, float cosOuter, bool spot)\n"
"{\n"
"	if(!(reach > 0.0f))\n"
"		return false;\n"
"	float vx = p.x - centre.x, vy = p.y - centre.y, vz = p.z - centre.z;\n"
"	float d2 = vx*vx + vy*vy + vz*vz;\n"
"	if(!(d2 <= reach*reach))\n"
"		return false;\n"
"	if(!spot || d2 == 0.0f)\n"
"		return true;\n"
"	return ltInCone(LTVec3{ vx - off.x, vy - off.y, vz - off.z }, dir, cosOuter) ||\n"
"	       ltInCone(LTVec3{ vx + off.x, vy + off.y, vz + off.z }, dir, cosOuter);\n"
"}\n"

"static inline bool\n"
"ltRayWanted(LTVec3 p, LTVec3 lightPos, float radius, LTVec3 dir, float cosOuter, bool spot)\n"
"{\n"
"	return ltRayWantedSlot(p, lightPos, radius, LTVec3{ 0.0f, 0.0f, 0.0f }, dir, cosOuter, spot);\n"
"}\n"

"static inline float\n"
"ltRayLength(float dist, float backoff)\n"
"{\n"
"	return LT_MAX(dist - backoff, 0.0f);\n"
"}\n"

"static inline LTVec3\n"
"ltDiscToward(LTVec3 toLight, float softness, float dist, float u1, float u2)\n"
"{\n"
"	if(!(softness > 0.0f) || !(dist > 0.0f))\n"
"		return toLight;\n"
"	LTVec3 a = toLight.x*toLight.x < 0.25f ? LTVec3{1.0f, 0.0f, 0.0f} : LTVec3{0.0f, 1.0f, 0.0f};\n"
"	LTVec3 t1 = {toLight.y*a.z - toLight.z*a.y, toLight.z*a.x - toLight.x*a.z, toLight.x*a.y - toLight.y*a.x};\n"
"	float inv1 = 1.0f/LT_SQRT(t1.x*t1.x + t1.y*t1.y + t1.z*t1.z);\n"
"	t1.x *= inv1; t1.y *= inv1; t1.z *= inv1;\n"
"	LTVec3 t2 = {toLight.y*t1.z - toLight.z*t1.y, toLight.z*t1.x - toLight.x*t1.z, toLight.x*t1.y - toLight.y*t1.x};\n"
"	float r = softness*LT_SQRT(u1), phi = 6.2831853f*u2;\n"
"	float s = r*LT_COS(phi), t = r*LT_SIN(phi);\n"
"	LTVec3 v = {toLight.x*dist + t1.x*s + t2.x*t, toLight.y*dist + t1.y*s + t2.y*t, toLight.z*dist + t1.z*s + t2.z*t};\n"
"	float inv = 1.0f/LT_SQRT(v.x*v.x + v.y*v.y + v.z*v.z);\n"
"	return LTVec3{v.x*inv, v.y*inv, v.z*inv};\n"
"}\n"

"#endif\n"
;
